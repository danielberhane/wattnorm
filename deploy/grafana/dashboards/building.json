  {
   "id": 9,
   "type": "table",
   "title": "Alerts",
   "datasource": {
    "type": "grafana-postgresql-datasource",
    "uid": "timescaledb"
   },
   "gridPos": {
    "x": 0,
    "y": 23,
    "w": 24,
    "h": 9
   },
   "targets": [
    {
     "datasource": {
      "type": "grafana-postgresql-datasource",
      "uid": "timescaledb"
     },
     "refId": "A",
     "format": "table",
     "rawQuery": true,
     "rawSql": "SELECT started_at AS \"Started\", alert_type AS \"Type\", round(extract(epoch FROM coalesce(ended_at, now()) - started_at)/60) AS \"Minutes\", round(observed_kw::numeric,1) AS \"Observed kW\", round(expected_kw::numeric,1) AS \"Expected kW\", round(peak_z::numeric,1) AS \"Peak z\", round(excess_kwh::numeric,1) AS \"Excess kWh\", round(co2_kg::numeric,1) AS \"CO2 kg\", round(cost_usd::numeric,2) AS \"USD\", (SELECT string_agg(d->>'feature' || ' ' || to_char((d->>'contribution_kw')::numeric,'SG990.0') || ' kW', ', ')  FROM jsonb_array_elements(drivers) d) AS \"Why (top drivers of expectation)\", CASE WHEN ended_at IS NULL THEN 'OPEN' ELSE 'closed' END AS \"State\", model_version AS \"Model\" FROM alerts WHERE $__timeFilter(started_at) AND meter_id = '$meter' ORDER BY started_at DESC LIMIT 100"
    }
   ],
   "fieldConfig": {
    "defaults": {
     "custom": {
      "align": "auto",
      "cellOptions": {
       "type": "auto"
      },
      "inspect": false
     },
     "thresholds": {
      "mode": "absolute",
      "steps": [
       {
        "color": "green",
        "value": null
       }
      ]
     },
     "color": {
      "mode": "thresholds"
     }
    },
    "overrides": []
   },
   "options": {
    "showHeader": true,
    "cellHeight": "sm",
    "footer": {
     "show": false,
     "reducer": [
      "sum"
     ],
     "countRows": false,
     "fields": ""
    }
   },
